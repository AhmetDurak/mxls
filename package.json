{
  "name": "@adrk/mxls",
  "version": "1.0.8",
  "description": "Monaco XML Language Support — schema-driven autocomplete, validation, and template generation",
  "license": "MIT",
  "author": "Ahmet Durak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmetDurak/mxls.git"
  },
  "homepage": "https://github.com/AhmetDurak/mxls#readme",
  "keywords": [
    "monaco",
    "xml",
    "xsd",
    "autocomplete",
    "validation",
    "language-server",
    "editor"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "style.css",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clear": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clear && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@xmldom/xmldom": "^0.9.10",
    "prettier": "^3.8.3",
    "ts-debounce": "^5.0.1",
    "turndown": "^7.2.4"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.30.0"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "monaco-editor": "^0.57.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
